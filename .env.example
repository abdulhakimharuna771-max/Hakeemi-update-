# ---------------------------------------------------------------------------
# GIZMO DAN KAITA OFFICE PLUS — Final Year Project & Innovation Development
# Program · Registration & Applicant Portal (Phase 1)
#
# Copy this file to .env.local and fill in the values. .env.local is ignored by
# git — never commit real keys.
#
#   cp .env.example .env.local
#   npm run check:config      # validates everything below, offline
# ---------------------------------------------------------------------------

# --- Required: your Supabase project ----------------------------------------
# Supabase dashboard → Project Settings → Data API (or API Keys).
# Both values are public by design: Row Level Security, not secrecy, is what
# protects applicant data. The publishable/anon key is safe in the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# NEVER put a service-role / secret key in this application. It is not read
# anywhere in this codebase and must not be added: every database access goes
# through the signed-in user's own session with RLS enforced.
# `npm run check:config` fails if one is present.

# --- Recommended: deployment origin -----------------------------------------
# Absolute origin used to build the email links Supabase Auth sends
# (confirm signup, reset password). Leave blank in local development.
# Example: https://portal.example.org
NEXT_PUBLIC_SITE_URL=

# --- Public contact details (optional) --------------------------------------
# Only the values you set are displayed, in the order given. Anything left
# blank is hidden — the site never invents a phone number, address or email.
NEXT_PUBLIC_CONTACT_EMAIL=
# One or more numbers, comma-separated. Displayed as 0802 908 8338.
NEXT_PUBLIC_CONTACT_PHONES=
# Separate multiple address lines with a pipe character:
# NEXT_PUBLIC_CONTACT_ADDRESS=12 Example Road|Ibadan|Oyo State
NEXT_PUBLIC_CONTACT_ADDRESS=
NEXT_PUBLIC_CONTACT_HOURS=Monday to Friday, 9:00am – 5:00pm
# Used for the WhatsApp link (wa.me). Defaults to the first number above.
NEXT_PUBLIC_CONTACT_WHATSAPP=

# --- Social presence (optional) ---------------------------------------------
# A single handle used across platforms. It is displayed as text, never as a
# guessed profile URL.
NEXT_PUBLIC_SOCIAL_HANDLE=
# To publish real links instead, list Name=URL pairs:
# NEXT_PUBLIC_SOCIAL_LINKS=Facebook=https://facebook.com/example,Instagram=https://instagram.com/example
NEXT_PUBLIC_SOCIAL_LINKS=

# --- Live verification (optional) -------------------------------------------
# Base address for the disposable accounts created by `npm run verify:live`.
# Sub-addressing gives each run its own alias, so your inbox still works.
# VERIFY_LIVE_EMAIL=Gizmoofficeplus@gmail.com

# --- Local development only (optional) --------------------------------------
# Extra Host headers accepted by the dev server. Comma-separated, wildcards
# allowed. Needed only when you preview the app through a tunnel or sandbox
# hostname instead of localhost.
# NEXT_ALLOWED_DEV_ORIGINS=*.e2b.app,localhost,127.0.0.1
